{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Parts Bin",
  "version": "4.0.0",
  "identifier": "com.printlab3d.partsbin",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Parts Bin",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "./installer/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRTk5RkQyQjY0MjE2QkEKUldTNkZrSzIwcC9wa0xGQVJMTVBGa1B2UFdESEFjUThGK1dWc1ZjWXVzd3dVVWlNbjBib0VRVmgK",
      "endpoints": [
        "https://github.com/PrintLab3D-offical/Part-bin/releases/latest/download/latest.json"
      ]
    }
  }
}